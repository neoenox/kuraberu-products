/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://platform.twitter.com https://assets.pinterest.com https://widgets.pinterest.com https://embed.reddit.com; frame-src https://platform.twitter.com https://assets.pinterest.com https://www.youtube-nocookie.com https://www.tiktok.com https://www.redditmedia.com https://embed.reddit.com; connect-src 'self' https://platform.twitter.com https://cdn.syndication.twimg.com https://api.twitter.com https://assets.pinterest.com https://embed.reddit.com; img-src 'self' data: https://pbs.twimg.com https://abs.twimg.com https://i.pinimg.com https://*.image.rakuten.co.jp https://resource.logitech.com https://assets.micron.com https://media.kingston.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' https://www.youtube-nocookie.com https://www.tiktok.com; form-action 'self'
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Article HTML must revalidate instead of being cached for days. Unpublished
# articles are pruned from the build (#1088); a long-lived edge cache entry for
# a removed URL would keep serving stale HTML after it should 404. Pinning the
# header here prevents TTL drift from re-caching article HTML with a long
# shared max-age.
/articles/*
  Cache-Control: public, max-age=0, must-revalidate

