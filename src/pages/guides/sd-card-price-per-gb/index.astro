---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SD_CARD_CHECKED_AT, perGb, sdCardOffers } from '../../../data/sd-card-prices';
import { ARTICLE_LAYOUT } from '../../../../config/article-layout.mjs';
import { isAffiliateRakutenUrl } from '../../../../config/runtime-env.mjs';

const title = 'SDカード（4K動画向け）は1GBいくら？容量別の最安を楽天の価格で比べた｜くらべる商品メモ';
const description =
  '4K動画の撮影に使う SDXC カード（UHS-I U3・V30）を、64GB・128GB・256GB・512GB の容量別に、送料込みの楽天市場の価格から1GBあたりで比べました。';

const offers = [...sdCardOffers]
  .map((offer) => ({ ...offer, each: perGb(offer), href: offer.affiliateUrl }))
  .sort((a, b) => a.each - b.each);

// 成果報酬つきURLでない購入ボタンは公開させない（ビルドを失敗させる）
for (const offer of offers) {
  if (!isAffiliateRakutenUrl(offer.href)) {
    throw new Error(`sd card guide: not an affiliate URL: ${offer.id}`);
  }
}

const sandisk = offers
  .filter((offer) => offer.model.startsWith('サンディスク'))
  .sort((a, b) => a.capacityGb - b.capacityGb);
const smallest = sandisk[0];
const largest = sandisk[sandisk.length - 1];
const dropPercent = Math.round((1 - largest.each / smallest.each) * 100);
const cheapest = offers[0];

// 100Mbps（12.5MB/s）で連続記録した場合の理論値（音声・管理領域を除く）
const minutesFor = (gb: number) => Math.round((gb * 1000) / 12.5 / 60 / 5) * 5;
const capacities = [...new Set(offers.map((offer) => offer.capacityGb))].sort((a, b) => a - b);

const yen = (value: number) => value.toLocaleString('ja-JP');
const [year, month, day] = SD_CARD_CHECKED_AT.split('-').map(Number);
const checkedLabel = `${year}年${month}月${day}日`;
---

<BaseLayout title={title} description={description}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / SDカードの価格</p>

    <h1>SDカード（4K動画向け）は1GBいくら？容量別の最安を比べた</h1>
    <p class="lead">
      4K動画を撮るカメラには、速い SD カードが要ります。容量が大きいほど、1GBあたりは安くなるのか。楽天市場の価格を、1GBあたりに直して比べました。結論は、<strong>大きい容量ほど安く、サンディスクは{smallest.capacityGb}GBと{largest.capacityGb}GBで、1GBあたり約{dropPercent}％の差</strong>です。
    </p>

    <p class="notice">広告・PRを含みます。価格は{checkedLabel}に取得した値で、順位は価格だけで決めています。</p>

    <h2>結論：迷ったら、使い切れる範囲で、大きい容量</h2>
    <ul>
      <li>サンディスク Extreme Pro は、{smallest.capacityGb}GBで1GBあたり{smallest.each}円、{largest.capacityGb}GBで{largest.each}円でした。</li>
      <li>いちばん安かったのは、{cheapest.model}の{cheapest.capacityGb}GB（{cheapest.shop}、{yen(cheapest.price)}円）で、1GBあたり{cheapest.each}円です。ただし、販売ページに「海外リテール」と書かれている出品です。</li>
      <li>大容量にすると、合計金額は上がります。撮る量が少ない人は、1GBあたりの安さより、合計金額で選んでも問題ありません。</li>
    </ul>

    <h2>容量ごとの、撮影できる時間の目安</h2>
    <p>4K動画（XAVC S、100Mbps）を、途中で止めずに撮り続けた場合の、理論上の時間です。音声やカードの管理領域は入れていないので、実際は、これより短くなります。</p>
    <div class="table-scroll">
      <table class="comparison">
        <thead>
          <tr><th scope="col">容量</th><th scope="col">撮影時間の目安</th></tr>
        </thead>
        <tbody>
          {capacities.map((gb) => (
            <tr>
              <th scope="row">{gb}GB</th>
              <td data-label="撮影時間の目安">約{minutesFor(gb)}分</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>1GBあたりの価格（安い順）</h2>
    <div class="table-scroll">
      <table class="comparison">
        <thead>
          <tr>
            <th scope="col">カード</th>
            <th scope="col">1GBあたり</th>
            <th scope="col">合計（税込・送料込み）</th>
            <th scope="col">ショップと注意点</th>
            <th scope="col">購入</th>
          </tr>
        </thead>
        <tbody>
          {offers.map((offer) => (
            <tr>
              <th scope="row">{offer.model}<br />{offer.capacityGb}GB</th>
              <td data-label="1GBあたり"><strong>{offer.each}円</strong></td>
              <td data-label="合計">{yen(offer.price)}円</td>
              <td data-label="ショップと注意点">
                {offer.shop}
                {offer.note && <><br /><span class="meta">{offer.note}</span></>}
              </td>
              <td data-label="購入">
                <a
                  href={offer.href}
                  target="_blank"
                  rel="sponsored nofollow noopener noreferrer"
                  data-cta-event={ARTICLE_LAYOUT.ctaEvent}
                  data-placement={ARTICLE_LAYOUT.guidePlacement}
                  data-product-id={offer.id}
                >楽天市場で見る →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="meta">{checkedLabel}時点。価格・在庫は変わります。購入前に、販売ページで、価格・送料・在庫と、カードの規格を確認してください。</p>

    <h2>4K動画に、どんなカードが必要か</h2>
    <p>
      ソニー VLOGCAM ZV-1F の<a href="https://www.sony.jp/vlogcam/products/ZV-1F/spec.html" target="_blank" rel="noopener noreferrer">公式仕様ページ</a>には、XAVC S（100Mbps）の4K動画は、UHS-I U3 以上の SDXC / SDHC カードで記録する、と書かれています。この記事で比べたカードは、どちらも UHS-I U3・V30 と表示されています。
    </p>
    <p>
      ZV-1 II の公式仕様ページには、同じ条件の記載を確認できませんでした。お使いのカメラの取扱説明書やヘルプガイドで、必要なカードの条件を確認してから、買ってください。
    </p>

    <h2>比べ方</h2>
    <ul>
      <li>対象は、フルサイズの SDXC カード（UHS-I U3・V30）です。microSD・並行輸入品・複数枚セット・ノーブランド品は入れていません。</li>
      <li>「送料込み」と表示された出品だけを比べました。送料別の出品は、送料しだいで順位が入れ替わるため、除いています。</li>
      <li>容量ごとに、ブランド（サンディスク、キオクシア）別に、送料込みで在庫のある出品のうち、最安の1件だけを載せています。</li>
      <li>速度は、サンディスクの販売ページに、読み出し最大200MB/s、キオクシアは100MB/sと表示されています（販売ページの表記）。</li>
      <li>価格は楽天市場商品検索APIで取得した、税込の販売価格です。</li>
    </ul>

    <h2>カメラは決まっていますか？</h2>
    <p>Vlog 向けのカメラを選んでいる場合は、次の記事が参考になります。</p>
    <ul>
      <li><a href="/articles/sony-zv-1-ii-vs-zv-1f/">ソニー ZV-1 II と ZV-1F の違い</a></li>
    </ul>
  </article>
</BaseLayout>
