---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  INSTAX_PATTERN_CHECKED_AT,
  PATTERN_PACK_SHEETS,
  instaxPatternOffers,
  perSheet,
} from '../../../data/instax-pattern-film-prices';
import { instaxFilmOffers, perSheet as plainPerSheet } from '../../../data/instax-film-prices';
import { ARTICLE_LAYOUT } from '../../../../config/article-layout.mjs';
import { isAffiliateRakutenUrl } from '../../../../config/runtime-env.mjs';

const title = 'instax mini 絵柄つきフィルムは1枚いくら？柄ごとの最安を比べた｜くらべる商品メモ';
const description =
  'チェキ（instax mini）の絵柄つきフィルムとモノクロームを、柄ごとに、送料込みの楽天市場の価格から1枚あたりで比べました。無地のフィルムより、どれだけ高いかがわかります。';

const offers = [...instaxPatternOffers]
  .map((offer) => ({ ...offer, each: perSheet(offer), href: offer.affiliateUrl }))
  .sort((a, b) => a.each - b.each);

// 成果報酬つきURLでない購入ボタンは公開させない（ビルドを失敗させる）
for (const offer of offers) {
  if (!isAffiliateRakutenUrl(offer.href)) {
    throw new Error(`instax pattern film guide: not an affiliate URL: ${offer.id}`);
  }
}

const plain = instaxFilmOffers.find((offer) => offer.sheets === PATTERN_PACK_SHEETS)!;
const plainEach = plainPerSheet(plain);
const mono = offers.find((offer) => offer.pattern === 'モノクローム')!;
const patterned = offers.filter((offer) => offer.pattern !== 'モノクローム');
const gaps = patterned.map((offer) => Math.round(offer.each - plainEach));
const minGap = Math.min(...gaps);
const maxGap = Math.max(...gaps);
const yen = (value: number) => value.toLocaleString('ja-JP');
const [year, month, day] = INSTAX_PATTERN_CHECKED_AT.split('-').map(Number);
const checkedLabel = `${year}年${month}月${day}日`;
const diffLabel = (each: number) => {
  const diff = Math.round((each - plainEach) * 10) / 10;
  return diff < 0 ? `${Math.abs(diff)}円安い` : `${diff}円高い`;
};
---

<BaseLayout title={title} description={description}>
  <article class="wrap section article">
    <p class="meta"><a href="/articles/">比較記事一覧</a> / instax mini 絵柄つきフィルムの価格</p>

    <h1>instax mini 絵柄つきフィルムは1枚いくら？柄ごとの最安を比べた</h1>
    <p class="lead">
      チェキの絵柄つきフィルムは、無地より、どれだけ高いのか。楽天市場の価格を、10枚入り1パックの、1枚あたりに直して比べました。結論は、<strong>モノクロームは無地より安く、ほかの柄は1枚あたり{minGap}〜{maxGap}円高い</strong>です。
    </p>

    <p class="notice">広告・PRを含みます。価格は{checkedLabel}に取得した値で、順位は価格だけで決めています。</p>

    <h2>結論：柄によって、無地との差は{minGap}円から{maxGap}円</h2>
    <p>
      白フレームの無地（10枚入り）は、送料込みで、1枚あたり{plainEach}円でした（<a href="/guides/instax-mini-film-price/">無地フィルムの価格ガイド</a>）。これを基準にすると、次のとおりです。
    </p>
    <ul>
      <li>モノクロームは、{mono.shop}の{yen(mono.price)}円で、1枚あたり{mono.each}円。無地より{diffLabel(mono.each)}。</li>
      <li>いちばん差が小さい柄は、{patterned[0].pattern}で、無地より{diffLabel(patterned[0].each)}。</li>
      <li>いちばん差が大きい柄は、{patterned[patterned.length - 1].pattern}で、無地より{diffLabel(patterned[patterned.length - 1].each)}。</li>
    </ul>
    <p>
      10枚を撮るのに、差額は、無地との比較で、{minGap * PATTERN_PACK_SHEETS}円から{maxGap * PATTERN_PACK_SHEETS}円です。特別な1枚に使うなら、気になる金額ではないかもしれません。普段使いなら、無地とあわせて、買う枚数を決めるのがおすすめです。
    </p>

    <h2>柄ごとの1枚あたりの価格（安い順）</h2>
    <div class="table-scroll">
      <table class="comparison">
        <thead>
          <tr>
            <th scope="col">柄</th>
            <th scope="col">1枚あたり</th>
            <th scope="col">10枚入りの合計（税込・送料込み）</th>
            <th scope="col">ショップと注意点</th>
            <th scope="col">購入</th>
          </tr>
        </thead>
        <tbody>
          {offers.map((offer) => (
            <tr>
              <th scope="row">{offer.pattern}</th>
              <td data-label="1枚あたり"><strong>{offer.each}円</strong><br /><span class="meta">無地より{diffLabel(offer.each)}</span></td>
              <td data-label="合計">{yen(offer.price)}円</td>
              <td data-label="ショップと注意点">
                {offer.shop}
                {offer.note && <><br /><span class="meta">{offer.note}</span></>}
              </td>
              <td data-label="購入">
                <a
                  href={offer.href}
                  target="_blank"
                  rel="sponsored nofollow noopener noreferrer"
                  data-cta-event={ARTICLE_LAYOUT.ctaEvent}
                  data-placement={ARTICLE_LAYOUT.guidePlacement}
                  data-product-id={offer.id}
                >楽天市場で見る →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="meta">{checkedLabel}時点。価格・在庫は変わります。購入前に、販売ページで、価格・送料・在庫を確認してください。</p>

    <h2>比べ方</h2>
    <ul>
      <li>対象は、10枚入り1パックの、instax mini 用の絵柄つきフィルムとモノクロームです。ワイド・スクエア・中古・まとめ売りは入れていません。</li>
      <li>「送料込み」と表示された出品だけを比べました。送料別の出品は、送料しだいで順位が入れ替わるため、除いています。</li>
      <li>柄ごとに、送料込みで、在庫のある出品のうち、最安の1件だけを載せています。</li>
      <li>無地との差は、<a href="/guides/instax-mini-film-price/">無地フィルムの価格ガイド</a>で載せた、10枚入り1パックの1枚あたり価格（{plainEach}円）との差です。</li>
      <li>価格は楽天市場商品検索APIで取得した、税込の販売価格です。</li>
    </ul>

    <h2>カメラは決まっていますか？</h2>
    <p>instax mini のフィルムは、instax mini シリーズのカメラで使えます。カメラをまだ選んでいない場合は、次の記事が参考になります。</p>
    <ul>
      <li><a href="/articles/instax-mini-13-vs-mini-41/">instax mini 13 と mini 41 の違い</a></li>
      <li><a href="/articles/instax-mini-evo-vs-evo-cinema/">instax mini Evo と Evo Cinema の違い</a></li>
    </ul>
  </article>
</BaseLayout>
