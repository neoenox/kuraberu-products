---
import { Picture } from 'astro:assets';
import type {ArticleMetadata} from '../content/articles';
import {contentTypeFor} from '../../config/article-layout.mjs';
import {contentTypeLabel} from '../lib/content-types';
import {comparisonSubjects} from '../lib/article-subjects';
import {resolveImage} from '../lib/image-resolver';

interface Props {
  article: ArticleMetadata;
  /**
   * カード見出しのレベル。既定は h2（一覧頁など h1 直下で使う場合）。
   * トップページのように h2 セクション見出し配下で使う場合は h3 を渡す。
   */
  headingLevel?: 'h2' | 'h3';
  /**
   * 記事カードに付与する追加の data-* 属性（記事一覧の検索フィルタ用）。
   * 例: {'data-article-card': '', 'data-search': '…', 'data-category': '…', 'data-tags': '…'}
   */
  data?: Record<string, string>;
}

const {article, headingLevel = 'h2', data} = Astro.props;
const subjects = comparisonSubjects(article);
const resolvedImage = resolveImage(article.imagePath);
const Heading = headingLevel;
---

<article
  class="card article-list-card"
  data-content-type={contentTypeFor(article.productCount)}
  data-thumb={article.imagePath ? 'image' : 'tile'}
  {...data}
>
  {resolvedImage ? (
    <Picture class="card-thumb" src={resolvedImage} alt={article.headline} width={132} height={132} loading="lazy" formats={["avif", "webp"]} />
  ) : (
    <div class="card-tile" role="img" aria-label={`商品比較：${article.category}`}>
      <span class="card-tile-label">{article.category}</span>
    </div>
  )}
  <div class="card-body">
    <span class="card-tag-row">
      <span class="tag">{article.category}</span>
      <span class="tag tag--type">{contentTypeLabel(article.productCount)}</span>
    </span>
    <Heading><a href={article.path}>{article.headline}</a></Heading>
    {subjects && <p class="card-subjects">{subjects.join(' / ')}</p>}
    {article.audiences.length > 0 && (
      <p class="card-audiences">向き: {article.audiences.join('・')}</p>
    )}
  </div>
</article>
