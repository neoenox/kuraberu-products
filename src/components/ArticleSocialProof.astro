---
// SNS投稿が確認できた場合だけ投稿リンクまたは埋め込みを表示する。
// 比較の根拠は常にメーカー公式情報であり、SNSは参考情報に限定する。
import type { ExternalEmbedMatchRank } from "../lib/external-embeds";
import { createExternalEmbedConfig } from "../lib/external-embeds";

interface Props {
  query: string;
  checkedAt?: string;
  hasPosts?: boolean;
  /** 埋め込み投稿の採用基準ランクの最上位（model / series / brand）。brand のみなら非表示 */
  bestMatch?: ExternalEmbedMatchRank;
  /** 投稿本文を転載せず、確認済みの公開投稿へ直接案内する。 */
  directPosts?: readonly { label: string; href: string; note?: string }[];
  searchLabel?: string;
  searchCaption?: string;
}

const { hasPosts = false, bestMatch, directPosts = [], searchLabel, searchCaption } = Astro.props;
const hasEmbeddedPosts = Astro.slots.has("default");
const curatedPosts = directPosts.map((post) => ({
  ...post,
  href: post.href.includes("x.com/")
    ? createExternalEmbedConfig("x", post.href).canonicalUrl
    : post.href,
}));
const visible = Boolean(Astro.props.query?.trim()) &&
  (hasPosts || hasEmbeddedPosts || curatedPosts.length > 0);
---
{visible ? (
  <section
    class="article-social-proof"
    id="sns"
    data-best-match={bestMatch}
  >
    <h2>SNS での感想（参考情報）</h2>
    {hasPosts && bestMatch && bestMatch !== "brand" && curatedPosts.length > 0 && (
      <div class="sns-curated-posts">
        <p class="sns-posts-note">対象商品または同シリーズについて確認できる公開投稿へのリンクです。投稿内容は参考情報としてご覧ください。</p>
        <ul>
          {curatedPosts.map((post) => post.href && (
            <li>
              <a class="card-link sns-post-link" href={post.href} target="_blank" rel="noopener noreferrer">
                {post.label} →
              </a>
              {post.note && <p class="sns-search-caption">{post.note}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}
    <slot />
  </section>
) : null}

<style>
  .article-social-proof {
    margin-block: 2rem;
  }

  .sns-posts-note {
    margin: 0;
    color: var(--text-muted, #666);
    font-size: 0.9rem;
  }

  .sns-empty-state {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .sns-curated-posts ul {
    display: grid;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  .sns-post-link,
  .sns-search-link {
    width: fit-content;
    min-height: 44px;
  }

  .sns-search-fallback {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .sns-search-caption {
    margin: 0;
    color: var(--text-muted, #666);
    font-size: 0.8rem;
  }
</style>
