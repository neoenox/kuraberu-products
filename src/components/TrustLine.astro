---
interface Props {
  /**
   * 商品情報確認日（productInfoCheckedAt）。
   * 確認日が未宣言の記事（公開待ちの初稿テンプレート記事）は、
   * 確認済みを主張せず「広告を含みます」のみ表示する。
   */
  checkedAt?: string;
}

const { checkedAt } = Astro.props;
---

{/* 記事冒頭の確認日だけを表示する。広告表記は購入導線と免責ページで案内する。 */}
{checkedAt && <p class="trust-line">✓ 公式確認済み（{checkedAt}）</p>}
