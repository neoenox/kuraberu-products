---
import HeroComparison from './HeroComparison.astro';
import VisualKeyDifferences, { type KeyDiffRow } from './VisualKeyDifferences.astro';
import TrustLine from './TrustLine.astro';
import NextStepBlock from './NextStepBlock.astro';

interface Side {
  brand: string;
  line: string;
  tagline: string;
  image: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  officialHref: string;
  guidePoints: string[];
  /** 購入（アフィリエイト）URL — NextStepBlock の「次にすること」ボタン用 */
  purchaseHref?: string;
  /** クリック計測用の商品ID（任意） */
  productId?: string;
}

interface Props {
  left: Side;
  right: Side;
  rows: KeyDiffRow[];
  checkedAt?: string;
  /** 診断カテゴリページURL（省略時は診断一覧） */
  diagnosisHref?: string;
  /** 「この一覧以外は両商品とも同じ」の注記（VisualKeyDifferences の commonNote へ渡す） */
  commonNote?: string;
  /** 購入リンクの検証状態。verified を明示した場合だけ CTA を表示する。 */
  purchaseLinkStatus: "verified" | "direct" | "unverified" | "unavailable";
  showNextStepPurchaseCtas?: boolean;
  /** 現行のCommercialArticlePageでは購入先を記事末尾へまとめる。 */
  showNextStepBlock?: boolean;
}

const {
  left,
  right,
  rows,
  checkedAt,
  commonNote,
  diagnosisHref,
  purchaseLinkStatus,
  showNextStepPurchaseCtas = true,
  showNextStepBlock = true,
} = Astro.props;
---
{/*
  記事比較の標準骨格（現行の比較テンプレート）:
  1. 結論（HeroComparison）
  2. 主な比較ポイント（VisualKeyDifferences — 記事の主役）
  3. 信頼表示（TrustLine）
  ※ #decision-guide アンカーは統合ブロックが引き継ぎ、ページ内ジャンプを維持する。
*/}
<section class="article-comparison-v2" aria-label="商品の比較" data-next-step-purchase={showNextStepBlock ? "enabled" : "disabled"}>
  <HeroComparison
    heading="結局どっち？"
    anchorId="decision-guide"
    left={left}
    right={right}
    leftPoints={left.guidePoints}
    rightPoints={right.guidePoints}
  />
  <VisualKeyDifferences
    leftLabel={`${left.brand} ${left.line}`}
    rightLabel={`${right.brand} ${right.line}`}
    items={rows}
    commonNote={commonNote}
  />
  {showNextStepBlock && (
    <NextStepBlock
      left={{ label: `${left.brand} ${left.line}`, href: left.purchaseHref, productId: left.productId, image: left.image }}
      right={{ label: `${right.brand} ${right.line}`, href: right.purchaseHref, productId: right.productId, image: right.image }}
      diagnosisHref={diagnosisHref}
      purchaseLinkStatus={purchaseLinkStatus}
      showPurchaseCtas={showNextStepPurchaseCtas}
    />
  )}
  <TrustLine checkedAt={checkedAt} showDisclosure={false} />
</section>
